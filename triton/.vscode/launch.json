{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: 当前文件 (Triton 解释器模式)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
            "justMyCode": false,
            "env": {
                "TRITON_INTERPRET": "1"
            }
        }
    ]
}
