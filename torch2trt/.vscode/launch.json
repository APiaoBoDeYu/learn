{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
            "justMyCode": false
        },
        {
            "name": "Python: 当前文件 (Torch-TensorRT DEBUG 日志)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
            "justMyCode": false,
            "env": {
                "TORCH_TENSORRT_LOG_LEVEL": "DEBUG"
            }
        },
        {
            "name": "Python: 当前文件 (torch.compile 图/代码日志)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
            "justMyCode": false,
            "env": {
                "TORCH_LOGS": "graph_breaks,recompiles"
            }
        }
    ]
}
